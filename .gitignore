__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Generated build products
build/
dist/

# Locally downloaded authoring tools are never redistributed.
.tools/

# Third-party mods and assets used only for local research are never published.
Learning Sources/

# Native debug symbols are local build artifacts.
*.pdb

# Reproducible runtime build products. Build-Release recreates these before
# packaging. The wizard-guide ESP/SEQ pair is deliberately retained below as
# the consolidated xEdit generator's reviewed seed.
modules/*/mod/Scripts/*.pex
modules/parchment-picker/mod/SKSE/Plugins/*.dll
modules/*/mod/*.esp
!modules/wizard-guides/mod/DiegeticTravelWizardGuides.esp
modules/*/mod/SEQ/*.seq
!modules/wizard-guides/mod/SEQ/DiegeticTravelWizardGuides.seq

# Papyrus compiler assembly intermediates emitted beside compiled scripts.
modules/parchment-picker/mod/Scripts/*.pas

# Local gameplay/test watcher output is evidence for the current machine only.
logs/

# Local task handoff notes are not public project documentation.
HANDOFF.md
